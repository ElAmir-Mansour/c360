# =============================================================================
# Clario 360 — Environment Configuration
# Copy this file to .env and adjust values for your environment
# =============================================================================

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_SHUTDOWN_TIMEOUT=30s
# Runtime Watheeq Swagger UI/OpenAPI. Defaults on outside production and off in
# production unless explicitly enabled.
LEX_SWAGGER_ENABLED=

# --- Database (PostgreSQL 16) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=clario
DATABASE_PASSWORD=CHANGE_ME_dev_only
DATABASE_NAME=clario360
# In production this MUST be 'require' or 'verify-full'. 'disable' is dev-only.
DATABASE_SSL_MODE=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME=5m

# =============================================================================
# Docker Compose (read by docker-compose.yml at the repo root)
# These power the local clario360-postgres / clario360-minio / etc. containers.
# Set them in a real .env (which is gitignored) before running `docker compose up`.
# =============================================================================
POSTGRES_USER=clario
POSTGRES_PASSWORD=CHANGE_ME_dev_only
POSTGRES_DB=clario360
MINIO_ROOT_USER=clario_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_dev_only
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_dev_only
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_dev_only
# Disable for any environment with real users.
GRAFANA_ANON_ENABLED=false

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Kafka ---
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=clario360
KAFKA_AUTO_OFFSET_RESET=earliest

# --- Auth / JWT ---
AUTH_JWT_SECRET=change-me-in-production-use-256-bit-key
AUTH_JWT_ISSUER=clario360
AUTH_JWT_ACCESS_TOKEN_TTL=15m
AUTH_JWT_REFRESH_TOKEN_TTL=7d
AUTH_BCRYPT_COST=12

# --- MinIO (S3-compatible) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=clario_minio
MINIO_SECRET_KEY=CHANGE_ME_dev_only
MINIO_USE_SSL=false
MINIO_BUCKET=clario360

# --- Keycloak (optional external IdP) ---
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=clario360
KEYCLOAK_CLIENT_ID=clario-api
KEYCLOAK_CLIENT_SECRET=change-me

# --- Observability ---
LOG_LEVEL=debug
LOG_FORMAT=json
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=clario360
METRICS_ENABLED=true
METRICS_PORT=9090

# --- Encryption ---
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# --- Schema Registry ---
SCHEMA_REGISTRY_URL=http://localhost:8081

# =============================================================================
# WatheeqTech Second Brain (ai/second-brain — the "ai" compose profile)
# Brought up with:  docker compose --profile ai up -d
# =============================================================================
# Anthropic key for the /ask (generation) path ONLY. Blank => /ask returns 503
# "llm not configured"; /search (embeddings + pgvector) still works. Anthropic
# has NO embeddings API — this key is used exclusively for answer generation.
ANTHROPIC_API_KEY=
AI_LLM_MODEL=claude-opus-4-8
# Local multilingual embedding model (downloaded on first /ingest, ~2 GB incl.
# torch, persisted to the sb-models volume). 1024-dim must match the pgvector col.
AI_EMBEDDING_MODEL=intfloat/multilingual-e5-large
AI_EMBEDDING_DIM=1024
# Corpus source for /ingest: point at lex-service to pull the real catalog+bytes,
# else the mounted local corpus (docs/ClarioWatheeq) is used. See runbook §4.
AI_LEX_API_URL=
AI_LEX_API_TOKEN=
AI_LEX_TENANT_ID=
