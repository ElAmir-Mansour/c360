# ═══════════════════════════════════════════════════════════════════════════════
# Clario 360 — On-Box Backup Toolkit Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy to clario360-backup.env and adjust. Any value left unset falls back to
# deploy/vps/clario360.env (for POSTGRES_USER / POSTGRES_PASSWORD) or to the
# script defaults shown below. Environment variables override this file.
#
#   cp clario360-backup.env.example clario360-backup.env
#   chmod 600 clario360-backup.env
#
# Do NOT commit a populated clario360-backup.env — it contains DB credentials.
# ═══════════════════════════════════════════════════════════════════════════════

# --- Postgres access -----------------------------------------------------------
# Container name (production box: clario360-prod-postgres; local dev: clario360-postgres)
PG_CONTAINER=clario360-prod-postgres
# Credentials — usually inherited from deploy/vps/clario360.env; set here to override.
# POSTGRES_USER=clario
# POSTGRES_PASSWORD=

# --- What to back up -----------------------------------------------------------
# Space-separated database list. Default is the Watheeq/Al-Othaim critical pair.
# Full set: platform_core cyber_db data_db acta_db lex_db visus_db audit_db \
#           notification_db siem_db license_db dr_db workflow_db automation_db migrate_db keycloak
BACKUP_DBS="lex_db platform_core"

# custom = pg_dump -Fc (compressed, selective/parallel restore) [default]
# plain  = gzipped plain SQL (human-readable; the format OP-004 assumes)
BACKUP_FORMAT=custom

# --- Where + retention ---------------------------------------------------------
# Destination directory (created 0700). Prefer a persistent, ideally off-box volume.
BACKUP_DIR=/var/backups/clario360
# Prune runs older than this many days...
RETENTION_DAYS=14
# ...but always keep at least this many most-recent runs, regardless of age.
RETENTION_MIN_KEEP=7

# --- Verification --------------------------------------------------------------
# Set to 1 to have clario360-backup-verify.sh restore each dump into a throwaway
# scratch database, smoke-query it, then DROP it (fully reversible).
VERIFY_SCRATCH_RESTORE=0
