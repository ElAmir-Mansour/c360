# =============================================================================
# Clario 360 — VPS deploy config.  Copy to clario360.env and edit.
#   cp clario360.env.example clario360.env
# deploy.sh reads this on your workstation AND uploads it to
# /opt/clario360/clario360.env on the box (compose + pm2 ecosystem read it there).
# Blank credential fields are GENERATED on first `provision` and written back
# here so they persist. clario360.env is gitignored — never commit it.
# =============================================================================

##### --- SSH connection (workstation side) --------------------------------- #####
SSH_HOST=109.199.103.82
SSH_USER=root
SSH_KEY=~/.ssh/clario360_vps_deploy        # key authorized during setup
REMOTE_ROOT=/opt/clario360
COMPOSE_PROJECT=clario360

##### --- Exposure ---------------------------------------------------------- #####
# ip     -> http://<PUBLIC_IP>/ via a new nginx server_name block (no DNS needed)
# domain -> http(s)://<DOMAIN>/  (set DOMAIN; ENABLE_TLS=true runs certbot)
EXPOSE_MODE=domain
PUBLIC_IP=109.199.103.82
DOMAIN=devops.ofpsplatform.com              # DNS-only A record -> 109.199.103.82
ENABLE_TLS=true                             # true => certbot --nginx -d $DOMAIN
FRONTEND_PORT=3010                          # loopback; nginx proxies to it
GATEWAY_PORT=8092                           # loopback; nginx proxies /api to it

##### --- Demo data --------------------------------------------------------- #####
# true seeds the Watheeq/Legal-Affairs demo tenant "Abdullah Al Othaim
# Investment Company" + admin user (lex/acta). Required by lex-service at boot
# when on; the deploy runs system-seeder before lex starts.
SEED_DEMO_DATA=true

##### --- Infra credentials (leave BLANK; generated on first provision) ------ #####
POSTGRES_USER=clario
POSTGRES_PASSWORD=a6038ede0b1edfde5a2d1157b43d0b00bc6437e27c09b6b8
MINIO_ROOT_USER=clario_minio
MINIO_ROOT_PASSWORD=a8e864cf6a187af59f3218bc2cfb7ffc177b2563
SIEM_MINIO_ROOT_USER=clario_siem_minio
SIEM_MINIO_ROOT_PASSWORD=3e798446ba0ef0353665f337dfff2c1c246a2682
VAULT_DEV_ROOT_TOKEN_ID=63b8135772dfc761aaadece846d5c298c030bc773c949fac

##### --- Swap (recommended on this zero-swap box) -------------------------- #####
ADD_SWAP_GB=4                               # 0 to skip; cushions the Next.js build spike

# Shared secret for onboarding->license-service internal API (generated)
LICENSE_INTERNAL_TOKEN=ac32d4ee61751c6870b0feb674777401d5f2ef4fbe710213

# Uncomment to enable Reference-Library Ask (Second-Brain proxy in lex-service).
# LEX_AI_SERVICE_URL=http://127.0.0.1:8000
