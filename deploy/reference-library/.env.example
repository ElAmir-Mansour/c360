# =============================================================================
# WatheeqTech Reference Library + Second Brain — consolidated go-live env
# -----------------------------------------------------------------------------
# Copy to `.env` in this directory, fill in the REQUIRED values, then run
# `./up.sh` (bring-up) and `./smoke.sh` (go-live smoke). This one file covers
# ALL THREE surfaces:
#     1) lex-service        — catalog + download + /search|/ask proxy  (Go)
#     2) file-service       — object store for the PDF bytes (prod only, MinIO/S3)
#     3) Second Brain       — FastAPI RAG (pgvector + embeddings + Claude)
#
# Legend per variable:
#     [REQUIRED]  you MUST supply it (no safe default / feature is off without it)
#     [OPTIONAL]  safe to leave blank; enables an extra capability when set
#     [DEFAULT=x] has a working default in code; only set to override
#
# Every name below is the ACTUAL variable read by the code/compose/Helm — cross
# -checked against ai/second-brain/app/config.py, docker-compose.yml (profile
# "ai"), backend/internal/lex/app.go, backend/cmd/reference-library-seed, and
# deploy/helm/clario360/values.yaml. Detail lives in
# docs/ClarioWatheeq/WatheeqTech_Library_Runbook.md — this template does not
# duplicate it. Do NOT commit a filled-in .env (secrets).
# =============================================================================


# =============================================================================
# 0. MODE SELECTORS  (read by up.sh / smoke.sh — orchestration, not app code)
# =============================================================================

# [DEFAULT=volume]  Byte-storage backend for /reference-library/{id}/download.
#   volume        — dev / small deploys: lex streams PDFs from a mounted dir.
#                   Needs only LEX_REFERENCE_LIBRARY_DIR (section 1).
#   file-service  — production: lex fetches PDFs from the platform file-service /
#                   MinIO. Needs section 2 + the RS256 private key.
STORAGE_MODE=volume

# [DEFAULT=http://localhost:8000]  Where up.sh/smoke.sh reach the Second Brain
# directly (its own /health, /search, /ask, /ask/stream, /ingest). Internal-only
# service — it is NOT exposed through the gateway.
AI_URL=http://localhost:8000

# [REQUIRED for smoke.sh]  Base URL of the API gateway that fronts lex-service.
# Local dev: http://localhost:8092   VPS: https://devops.ofpsplatform.com
LEX_BASE_URL=http://localhost:8092

# [REQUIRED for smoke.sh]  A Watheeq-tenant JWT carrying lex:read (or
# lex:reference:view) on an `app.watheeq`-entitled tenant. smoke.sh sends it as
# `Authorization: Bearer $LEX_JWT` to the gateway. Mint via a normal login.
LEX_JWT=


# =============================================================================
# 1. lex-service  (Go — catalog, download, and the AI proxy)
# =============================================================================

# [REQUIRED]  lex_db connection string. up.sh applies migrations 000080-000083
# against this and the seeder writes the 33 catalog rows here. lex-service also
# reads it at boot (FATAL if migrations fail).
#   e.g. postgres://clario:clario_dev_pass@localhost:5436/lex_db?sslmode=disable
LEX_DB_URL=

# --- volume mode (STORAGE_MODE=volume) --------------------------------------
# [REQUIRED in volume mode]  Absolute path to the mounted read-only corpus dir
# holding the 33 PDFs (gitignored, ~95 MB — staged out-of-band per Runbook §2).
# lex streams bytes from here; the seeder hashes the files here.
LEX_REFERENCE_LIBRARY_DIR=/var/lib/clario360/reference-library

# --- file-service mode (STORAGE_MODE=file-service) --------------------------
# [REQUIRED in file-service mode]  In-cluster/base URL of the platform
# file-service that stores the PDF objects. k8s example:
# http://clario360-file-service:8092
LEX_FILE_SERVICE_URL=

# [REQUIRED in file-service mode]  Canonical "library tenant" UUID that owns the
# corpus objects in MinIO. lex mints this tenant's short-lived JWT to read them.
# The Helm render ABORTS if this is empty in file-service mode.
LEX_REFERENCE_LIBRARY_TENANT_ID=

# [REQUIRED in file-service mode]  RS256 PRIVATE key PEM CONTENT (not a path) —
# lex/the seeder MUST sign the library-tenant JWT with it (a validation-only,
# public-key-only lex cannot mint and downloads fall back / 502).
# Load with:  AUTH_RSA_PRIVATE_KEY_PEM="$(cat jwt-private.pem)"
AUTH_RSA_PRIVATE_KEY_PEM=
# [OPTIONAL]  Matching PUBLIC key PEM CONTENT. Provide it too when running the
# seeder standalone so config.Load() has a complete key pair.
AUTH_RSA_PUBLIC_KEY_PEM=

# --- AI proxy wiring (both modes) -------------------------------------------
# [OPTIONAL]  Second Brain base URL as seen BY lex-service. Set it to light up
# /reference-library/search + /ask + /ask/stream (unset => those return a clean
# 503 "second brain not configured"). Local pm2: http://localhost:8000 ;
# k8s: http://<release>-ai-second-brain:8000
LEX_AI_SERVICE_URL=http://localhost:8000


# =============================================================================
# 2. file-service / object store  (MinIO or S3 — ONLY for STORAGE_MODE=file-service)
# =============================================================================
# These configure the platform file-service (backend/cmd/file-service). Skip the
# whole section in volume mode. The library objects live in the bucket
# <FILE_MINIO_BUCKET_PREFIX>-lex  => with the default prefix that is `clario360-lex`.

# [REQUIRED in file-service mode]  S3/MinIO endpoint host:port (no scheme).
#   MinIO: minio:9000   AWS S3: s3.<region>.amazonaws.com
FILE_MINIO_ENDPOINT=
# [REQUIRED in file-service mode]  Object-store access key / ID.
FILE_MINIO_ACCESS_KEY=
# [REQUIRED in file-service mode]  Object-store secret key.
FILE_MINIO_SECRET_KEY=
# [DEFAULT=false]  Use TLS to the endpoint (true for real S3 / TLS MinIO).
FILE_MINIO_USE_SSL=false
# [DEFAULT=us-east-1]  Object-store region.
FILE_MINIO_REGION=us-east-1
# [DEFAULT=clario360]  Bucket prefix; the lex bucket is "<prefix>-lex".
# Leave as-is to get the expected `clario360-lex` bucket.
FILE_MINIO_BUCKET_PREFIX=clario360


# =============================================================================
# 3. Second Brain  (FastAPI RAG — pgvector + embeddings + Claude generation)
# =============================================================================
# Names below are exactly what ai/second-brain/app/config.py reads. When brought
# up via `docker compose --profile ai` (what up.sh does), a few are supplied
# through host-override names instead — see section 4.

# --- Vector store -----------------------------------------------------------
# [REQUIRED for a standalone/external pgvector]  pgvector Postgres DSN the AI
# service embeds into and searches. When up.sh uses the bundled compose pgvector
# this is set for you (see AI_DB_PASSWORD, section 4); set this only when you
# point at your OWN pgvector (k8s / managed PG with the `vector` extension).
AI_DATABASE_URL=postgresql://second_brain:second_brain@localhost:5433/second_brain

# --- Generation: choose ONE LLM path ----------------------------------------
# (a) CLOUD Anthropic (default). [REQUIRED for /ask] — without it /ask and
#     /ask/stream return 503 {"error":"llm not configured"}; /search still works.
ANTHROPIC_API_KEY=
# [DEFAULT=claude-opus-4-8]  Generation model id.
AI_LLM_MODEL=claude-opus-4-8
# [DEFAULT=8000]  Max output tokens per answer (clamped to the cap below).
AI_LLM_MAX_TOKENS=8000
# [DEFAULT=8000]  Hard per-request output ceiling (cost guard).
AI_LLM_MAX_TOKENS_CAP=8000
# [DEFAULT=high]  Generation effort: low | medium | high | xhigh | max.
AI_LLM_EFFORT=high
#
# (b) SOVEREIGN / in-Kingdom via an ANTHROPIC-COMPATIBLE endpoint. WORKS TODAY,
#     no code change: the official `anthropic` SDK reads ANTHROPIC_BASE_URL from
#     the environment, and generator.py constructs the client without overriding
#     base_url. Point this at your in-Kingdom Anthropic-compatible gateway and
#     set ANTHROPIC_API_KEY to that gateway's credential.
# [OPTIONAL]  e.g. https://claude-gw.your-kingdom-host/v1
ANTHROPIC_BASE_URL=
#
# (c) FULLY self-hosted, OpenAI-compatible — WIRED. Set AI_LLM_PROVIDER to switch
#     the generator to any OpenAI /v1/chat/completions endpoint: in-Kingdom vLLM /
#     TGI / Ollama / llama.cpp serving a sovereign Arabic model (ALLaM, Jais,
#     Falcon). Streaming (/ask/stream) works on this path too. With staged models
#     (make prefetch-models + HF_HUB_OFFLINE=1) every token stays in-Kingdom with
#     zero egress. Leave ANTHROPIC_API_KEY unset when using this path.
# [DEFAULT=anthropic]  anthropic | openai_compatible (aliases: vllm|tgi|ollama|allam)
AI_LLM_PROVIDER=anthropic
# [REQUIRED if provider=openai_compatible]  e.g. https://allam.gov.local/v1
AI_LLM_BASE_URL=
# [OPTIONAL]  bearer for the endpoint; blank for keyless local servers.
AI_LLM_API_KEY=

# --- Embeddings (local, multilingual, strong on Arabic) ---------------------
# [DEFAULT=intfloat/multilingual-e5-large]  Downloaded on first /ingest (~2 GB
# incl. torch) into HF_HOME. Runs offline after that.
AI_EMBEDDING_MODEL=intfloat/multilingual-e5-large
# [DEFAULT=1024]  Must match the embedding model's output dimension.
AI_EMBEDDING_DIM=1024
# [DEFAULT="query: " / "passage: "]  e5 prefixes. Blank BOTH for non-e5 models.
AI_EMBEDDING_QUERY_PREFIX=query:
AI_EMBEDDING_PASSAGE_PREFIX=passage:
# [DEFAULT=true]  L2-normalize embeddings (cosine similarity).
AI_EMBEDDING_NORMALIZE=true

# --- Reranking (cross-encoder; optional quality boost, graceful fallback) ----
# [DEFAULT=true]  Enable cross-encoder reranking of fused candidates.
RERANK_ENABLED=true
# [DEFAULT=BAAI/bge-reranker-v2-m3]  Any sentence-transformers CrossEncoder id.
# If the model/deps can't load, retrieval degrades to fused order (no crash).
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# [DEFAULT=20]  Rerank at most this many fused candidates.
RERANK_TOP_N=20

# --- OCR (scanned مجلة قضاء issues; tesseract + Arabic pack baked into image) -
# [DEFAULT=true]  OCR pages with too little extractable text.
OCR_ENABLED=true
# [DEFAULT=ara]  Tesseract language pack.
OCR_LANG=ara
# [DEFAULT=60]  A page with fewer extracted chars is treated as scanned.
OCR_MIN_CHARS=60
# [DEFAULT=300]  Rasterization DPI for OCR.
OCR_DPI=300

# --- HuggingFace model cache / air-gap --------------------------------------
# [DEFAULT=/models in the container]  Where embedding/rerank models are cached.
# Persist this across restarts or the ~2 GB model re-downloads every boot.
HF_HOME=/models
# [OPTIONAL]  Set to 1 for a fully air-gapped run AFTER models are pre-staged
# into HF_HOME — forbids any network fetch. Honored by the HuggingFace libraries
# (huggingface_hub / transformers), not by clario code. Leave blank for the
# first ingest so the model can download.
HF_HUB_OFFLINE=

# --- Corpus source for /ingest ----------------------------------------------
# [OPTIONAL]  Option A: pull the catalog + PDF bytes from lex via the gateway.
# Set to your gateway/lex base URL to embed the REAL served catalog:
#   GET {LEX_API_URL}/api/v1/lex/reference-library  +  /{id}/download
# Blank => the AI service ingests from its mounted local corpus (dev default,
# no token needed). NOTE: via the compose profile, set the AI_LEX_* host names
# in section 4 instead (they map onto these).
LEX_API_URL=
# [OPTIONAL]  Bearer token for Option A ingest (a Watheeq JWT with lex:read).
LEX_API_TOKEN=
# [OPTIONAL]  Tenant id header for Option A ingest.
LEX_TENANT_ID=


# =============================================================================
# 4. docker compose `--profile ai` host overrides  (what up.sh actually uses)
# =============================================================================
# The root docker-compose.yml "ai" profile reads these HOST names and maps them
# into the container. Same-named vars above (ANTHROPIC_API_KEY, AI_LLM_MODEL,
# AI_EMBEDDING_MODEL, AI_EMBEDDING_DIM) are used as-is; the ones below differ:

# [DEFAULT=second_brain]  Password for the BUNDLED pgvector container; the
# compose builds AI_DATABASE_URL from it. Change it for anything but throwaway
# local runs. (Ignored if you point AI_DATABASE_URL at your own pgvector.)
AI_DB_PASSWORD=second_brain

# [OPTIONAL]  Option-A ingest source for the compose AI service — these map onto
# the container's LEX_API_URL / LEX_API_TOKEN / LEX_TENANT_ID. Blank => ingest
# from the mounted local corpus (no token needed).
AI_LEX_API_URL=
AI_LEX_API_TOKEN=
AI_LEX_TENANT_ID=
