# ============================================================================
# WatheeqTech Second Brain — environment configuration
# Copy to `.env` and fill in. Every value below has a safe default in
# app/config.py EXCEPT ANTHROPIC_API_KEY (required for /ask).
# ============================================================================

# --- Vector store (pgvector on Postgres) ------------------------------------
# docker compose sets this automatically to the bundled `db` service.
AI_DATABASE_URL=postgresql://second_brain:second_brain@localhost:5432/second_brain

# --- Generation — pluggable LLM provider ------------------------------------
# Choose the LLM backend WITHOUT any code change. The selected provider gates
# /ask: if it is unconfigured, /ask returns HTTP 503 {"error":"llm not
# configured"} (never a fabricated answer). /search works regardless.
#
#   AI_LLM_PROVIDER=anthropic          -> Claude via the anthropic SDK (default)
#   AI_LLM_PROVIDER=openai_compatible  -> any OpenAI-format /v1/chat/completions
#                                         endpoint (vLLM / TGI / Ollama / OpenAI)
AI_LLM_PROVIDER=anthropic

# -- Provider: anthropic --
# REQUIRED when AI_LLM_PROVIDER=anthropic. Anthropic has NO embeddings API — this
# key is used only for answer generation.
ANTHROPIC_API_KEY=

# -- Provider: openai_compatible --
# Point at a self-hosted, KSA-resident Arabic model (ALLaM / Jais / Falcon) served
# in-Kingdom so ALL inference stays sovereign. AI_LLM_BASE_URL is required for this
# provider; AI_LLM_API_KEY is optional for keyless local servers (vLLM / Ollama).
# AI_LLM_MODEL below is the served model name.
#   AI_LLM_PROVIDER=openai_compatible
#   AI_LLM_BASE_URL=https://allam.gov.local/v1
#   AI_LLM_API_KEY=
#   AI_LLM_MODEL=allam-2-7b
AI_LLM_BASE_URL=
AI_LLM_API_KEY=

# Model name (Claude model id for anthropic; served model name for openai_compatible).
AI_LLM_MODEL=claude-opus-4-8
AI_LLM_MAX_TOKENS=8000
# Hard per-request output cap (cost guard): AI_LLM_MAX_TOKENS is clamped to this.
AI_LLM_MAX_TOKENS_CAP=8000
# Answer generation effort: low | medium | high | xhigh | max (anthropic only).
AI_LLM_EFFORT=high

# --- Embeddings (local multilingual model, strong on Arabic) ----------------
# Default: intfloat/multilingual-e5-large (1024-dim). Downloaded on first use
# (~2GB incl. torch). For a lighter model set:
#   AI_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
#   AI_EMBEDDING_DIM=768
#   AI_EMBEDDING_QUERY_PREFIX=      (blank — mpnet needs no prefix)
#   AI_EMBEDDING_PASSAGE_PREFIX=    (blank)
AI_EMBEDDING_MODEL=intfloat/multilingual-e5-large
AI_EMBEDDING_DIM=1024
AI_EMBEDDING_QUERY_PREFIX=query:
AI_EMBEDDING_PASSAGE_PREFIX=passage:
AI_EMBEDDING_NORMALIZE=true

# --- Offline / air-gapped model staging (sovereignty) -----------------------
# Hugging Face cache dir for the embedding + reranker models (~2GB). Stage them
# ONCE with `make prefetch-models` (or `--build-arg PREFETCH_MODELS=true`), then
# set HF_HUB_OFFLINE=1 so the service needs NO runtime internet egress.
HF_HOME=/models
# Set to 1 in an air-gapped datacenter AFTER models are staged. 0 = allow lazy
# download on first use (dev / online).
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# --- Corpus source ----------------------------------------------------------
# If LEX_API_URL is set, the catalog + PDF bytes are pulled from the lex service:
#   GET {LEX_API_URL}/api/v1/lex/reference-library         (metadata + doc_ids)
#   GET {LEX_API_URL}/api/v1/lex/reference-library/{id}/download   (bytes)
# Leave blank to fall back to the local manifest + PDF directory below.
LEX_API_URL=
LEX_API_TOKEN=
LEX_TENANT_ID=

# Local fallback (used only when LEX_API_URL is blank).
LIBRARY_PATH=../../docs/ClarioWatheeq/WatheeqTech Library
MANIFEST_PATH=../../docs/ClarioWatheeq/reference_library_manifest.json

# --- Chunking (Arabic-aware) ------------------------------------------------
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP=200
# Article-aware chunking: split Saudi statutes on نظام/مادة/فصل/الباب structure
# and carry article numbers into chunk metadata + citations. Safe to leave on
# (falls back to page chunking when a document has no article markers).
CHUNK_ARTICLE_AWARE=true

# --- Retrieval --------------------------------------------------------------
DEFAULT_TOP_K=8
MAX_TOP_K=50
SNIPPET_CHARS=320
# Retrieval mode: hybrid (vector + keyword fused) | vector | keyword
RETRIEVAL_MODE=hybrid
# Candidates each retriever fetches before fusion/rerank (final trimmed to top_k)
RETRIEVAL_CANDIDATE_K=40
# Reciprocal-Rank-Fusion constant (higher = flatter rank weighting)
HYBRID_RRF_K=60
# Postgres text-search config for keyword search. 'simple' does no stemming —
# correct for Arabic (no bundled Arabic stemmer); still gives exact-term recall.
KEYWORD_TS_CONFIG=simple

# --- Reranking (cross-encoder; optional, graceful fallback) -----------------
# A sentence-transformers CrossEncoder id. If the model/deps can't load,
# retrieval degrades to the fused order (no crash).
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_N=20

# --- Guardrails -------------------------------------------------------------
# Below this max cosine score /ask refuses ("not in the library") WITHOUT
# calling the LLM. Tune per embedding model (cosine, 0..1).
GUARDRAIL_MIN_SCORE=0.30
GUARDRAIL_MAX_QUESTION_CHARS=2000
GUARDRAIL_REQUIRE_CITATIONS=true

# --- Answer cache (question-hash -> answer) ---------------------------------
ANSWER_CACHE_ENABLED=true
ANSWER_CACHE_MAX_ENTRIES=512
ANSWER_CACHE_TTL_SECONDS=3600

# --- Rate limiting (per client: bearer token or IP) -------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_SEARCH_PER_MINUTE=120

# --- OCR (scanned مجلة قضاء issues) -----------------------------------------
# Requires the tesseract binary + Arabic pack + poppler (see README).
OCR_ENABLED=true
OCR_MIN_CHARS=60
OCR_LANG=ara
OCR_DPI=300

# --- Observability ----------------------------------------------------------
METRICS_ENABLED=true      # exposes Prometheus /metrics
LOG_JSON=true             # structured JSON logs (false => human text)
LOG_LEVEL=INFO

# --- HTTP -------------------------------------------------------------------
REQUEST_TIMEOUT=60
