# Optional environment overrides for clario-dr-agent.
# Install as /etc/clario360/clario-dr-agent.env with mode 0640 or tighter.

# Single-use enrollment token. Remove or rotate this value after the agent has
# enrolled and persisted its certificate under /var/lib/clario-dr-agent.
# CLARIO_DR_AGENT_ENROLLMENT_TOKEN=

# Optional path containing a fresh single-use rotate token. The agent rereads
# this file when its certificate enters the renewal window.
# CLARIO_DR_AGENT_RENEWAL_TOKEN_FILE=/run/clario-dr-agent/rotate-token.jwt

# Per-stream secrets. Stream IDs are uppercased and non-alphanumeric characters
# become underscores: orders-pg-logical -> ORDERS_PG_LOGICAL.
# CLARIO_DR_AGENT_DEK_CUSTOMERS_FILE=
# CLARIO_DR_AGENT_DEK_ORDERS_PG_LOGICAL=
# CLARIO_DR_AGENT_DEK_ORDERS_PG_LOGICAL_FILE=
# CLARIO_DR_AGENT_DSN_ORDERS_PG_LOGICAL=
# CLARIO_DR_AGENT_DSN_ORDERS_PG_LOGICAL_FILE=

# Non-secret operational overrides.
# CLARIO_DR_AGENT_METRICS_ADDR=127.0.0.1:9098
# CLARIO_DR_AGENT_RECONNECT_BACKOFF=1s
# CLARIO_DR_AGENT_MAX_RECONNECT_BACKOFF=30s
# CLARIO_DR_AGENT_CERT_RENEW_BEFORE=24h
# CLARIO_DR_AGENT_CERT_RENEW_CHECK_INTERVAL=1h
# CLARIO_DR_AGENT_CERT_RENEW_RETRY_BACKOFF=5m
# CLARIO_DR_AGENT_THROTTLE_BYTES_PER_SEC=10485760
